# Root .env for docker-compose. Do NOT commit secrets. Generate strong values.
# Quick start: cp .env.example .env && ./scripts/gen-secrets.sh  (fills in strong values)

# --- Domain / TLS (Caddy) ---
# Production domain (A record pointing here). Local smoke without TLS: PRIMARY_DOMAIN=:80
PRIMARY_DOMAIN=privacyvpn.example.com
ACME_EMAIL=                          # e-mail для Let's Encrypt (можно пустым для :80)
CP_PUBLIC_BASE_URL=https://privacyvpn.example.com   # для callback/return платёжного шлюза

POSTGRES_USER=vpn
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=vpn

# pepper for the account-number HMAC (secret store; changing it breaks existing numbers!)
CP_ACCOUNT_NUMBER_PEPPER=change-me-32+chars
# signing secret for cookie sessions
CP_SESSION_SECRET=change-me-32+chars
# Fernet key for email/TOTP: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CP_EMAIL_ENCRYPTION_KEY=
# can be turned off on an .onion-only setup with no TLS termination
CP_COOKIE_SECURE=true

# The first admin (created by scripts/bootstrap_admin.py, idempotent; password >=12 characters)
CP_BOOTSTRAP_ADMIN_USER=root
CP_BOOTSTRAP_ADMIN_PASSWORD=change-me-long-passphrase
# Secret admin path (defence in depth against brute force and scanners): set a
# high-entropy path — then /admin returns 404 and the console lives behind the secret.
# Generate: printf '/c-%s\n' "$(openssl rand -hex 8)". A layer ON TOP OF 2FA + rate limiting.
CP_ADMIN_PATH=/admin

# --- Payments ---
# Public control-plane URL (for the gateway's callback/return), e.g. https://privacyvpn.example.com
CP_PUBLIC_BASE_URL=

# BlockBee — the primary gateway (non-custodial "address per order"; BTC/LTC/USDT-TRC20).
# It issues an address_in per invoice, forwards to the operator's payout and sends a GET callback.
# Callback URL for the BlockBee dashboard: https://privacyvpn.example.com/v1/payments/webhook/blockbee
# There is no HMAC → callback authenticity rests on a per-invoice token HMAC(secret, order_id:expected)
# inside the callback URL. The secret itself never travels in the URL (a leaked log line does not reveal it).
CP_BLOCKBEE_ENABLED=false
CP_BLOCKBEE_API_KEY=                # API key из дашборда BlockBee
CP_BLOCKBEE_BASE_URL=https://api.blockbee.io
CP_BLOCKBEE_CALLBACK_SECRET=        # случайный мастер-секрет (напр. `openssl rand -hex 24`)
CP_BLOCKBEE_PAYOUT_BTC=             # payout-адрес оператора (BTC)
CP_BLOCKBEE_PAYOUT_LTC=             # payout-адрес оператора (LTC)
CP_BLOCKBEE_PAYOUT_USDT_TRC20=      # payout-адрес оператора (USDT TRC-20)

# OxaPay — an alternative hosted crypto gateway (no-KYC; XMR/BTC/LTC/USDT, one for every coin).
# WARNING: NOT strictly non-custodial — funds pass through an OxaPay balance (see docs/payments-setup.md).
CP_OXAPAY_ENABLED=false
CP_OXAPAY_API_KEY=                 # Merchant API key из дашборда OxaPay
CP_OXAPAY_BASE_URL=https://api.oxapay.com
CP_OXAPAY_AUTO_WITHDRAWAL=false    # false → вывод вручную; true → авто-вывод на кошельки оператора

# Sales: true → /buy works; false → "payment coming soon" (keep false until a gateway is wired up)
CP_PURCHASES_OPEN=false

# Alternative providers (self-hosted Monero / BTCPay / the NOWPayments gateway) — see docs/payments-setup.md

# --- Support: the private Telegram relay bot (see support-bot/README.md) ---
# Create a bot with @BotFather → token. Empty → the support-bot container just idles.
SUPPORT_BOT_TOKEN=                    # токен от @BotFather
SUPPORT_BOT_OPERATOR_CHAT_ID=        # твой личный Telegram chat_id (сюда падают сообщения; = чат алертов)
# Link to the bot → the "Support on Telegram" card on /support:
CP_SUPPORT_TELEGRAM_BOT=             # напр. https://t.me/privacyvpn_support_bot
# (optional) a public community group/channel and/or a DM handle:
CP_SUPPORT_TELEGRAM_URL=
CP_SUPPORT_TELEGRAM_DM=
# The announcement channel, appended by the bot's /links reply. That reply is the anti-phishing
# list of real addresses, so leaving this empty ships an incomplete list — the channel is where
# the site tells people which links are genuine.
SUPPORT_BOT_CHANNEL_URL=             # e.g. https://t.me/privacyvpn_vpn

# --- Public hosts for canonical/OpenGraph/sitemap URLs, first = primary (see app/seo.py) ---
# Keep the .onion listed: dropping it makes onion pages point their og:image at the clearnet.
CP_PUBLIC_HOSTS=privacyvpn.example.com,privacyvpn.example.net,privacyvpnexampleonionaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.onion
