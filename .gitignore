.env
.env.local
*.pem
*.key
id_ed25519*

# Backups / deploy artefacts
backups-out/
*.bak
*.bak.*
*.tgz

# OS / editor
.DS_Store
*.swp

# Local Claude settings
.claude/settings.local.json

# Playwright MCP session logs/screenshots
.playwright-mcp/

# design tooling (hallmark): local state, regenerated on demand
.hallmark/

# Gift-code stock: scripts/gift_txt.py writes ready-to-sell .txt files here by default.
# Each file is paid access to whoever holds it — it must never reach the history.
gift-out/
