# Control-plane configuration. CP_ prefix. Secrets belong in a secret store, NOT in the repo.

# DB: SQLite for dev/MVP, PostgreSQL for prod (at-rest encryption at the disk/volume level)
CP_DATABASE_URL=sqlite+pysqlite:///./control_plane.db
# CP_DATABASE_URL=postgresql+psycopg://vpn:password@db:5432/vpn

# Pepper for the account-number HMAC. A deterministic keyed hash: a seized DB without the pepper
# can be neither reversed nor brute-force checked. MUST be changed in production.
CP_ACCOUNT_NUMBER_PEPPER=dev-only-insecure-pepper-change-me

# Fernet key for encrypting the optional email (opt-in reminders). base64, 32 bytes.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CP_EMAIL_ENCRYPTION_KEY=

# Subscription lifecycle
CP_GRACE_PERIOD_DAYS=3
CP_DEFAULT_DEVICE_LIMIT=5

# Billing / invoices
CP_INVOICE_TTL_MINUTES=60
CP_RATE_LOCK_WINDOW_MINUTES=15
CP_BTC_CONFIRMATIONS_REQUIRED=2
CP_XMR_CONFIRMATIONS_REQUIRED=10
CP_ALLOW_ZERO_CONF=false

# How many minutes after activation to scrub the invoice<->account linkage (no-logs). 0 = immediately.
CP_INVOICE_LINK_RETENTION_MINUTES=0

# --- Payments (NON-CUSTODIAL: funds go to the operator's wallets; the CP is never a custodian) ---
# Monero (self-hosted monero-wallet-rpc, the default)
CP_MONERO_RPC_URL=
CP_MONERO_RPC_USER=
CP_MONERO_RPC_PASSWORD=
# BTCPay (BTC + Lightning + LTC, self-hosted; the operator holds the keys)
CP_BTCPAY_URL=
CP_BTCPAY_API_KEY=
CP_BTCPAY_STORE_ID=
CP_BTCPAY_WEBHOOK_SECRET=
# Gateway for USDT-TRC20 (off switch). WARNING: it sees the flows, requires merchant KYC, Tether-freeze risk.
CP_GATEWAY_ENABLED=false
CP_GATEWAY_BASE_URL=https://api.nowpayments.io
CP_GATEWAY_API_KEY=
CP_GATEWAY_IPN_SECRET=
CP_GATEWAY_PAYOUT_USDT_TRC20=
# confirmations (on-chain); Lightning is instant
CP_LTC_CONFIRMATIONS_REQUIRED=6
CP_USDT_CONFIRMATIONS_REQUIRED=20
CP_PAYMENT_UNDERPAID_TOLERANCE=0.01
